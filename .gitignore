.DS_Store
node_modules/
.env
*.log
.deno/

# conformance run screenshots are large binaries — regenerate with:
#   deno task responsive --page v<N>/<slug> --screenshots
reports/conformance/shots/
.pi-subagents/
# Python bytecode from the .claude helper scripts (gendn-crn). Without these, running
# .claude/fix-slugs.py leaves untracked .claude/__pycache__/ and "the working tree is clean" -
# a signal reviewers and landing lanes quote as evidence - is permanently false. Scoped to
# bytecode and the __pycache__ directory only: never .claude/ itself, whose .py sources are
# tracked and must stay visible to git status.
__pycache__/
*.pyc
