.DS_Store
node_modules/
.env
*.log
.deno/

# conformance run screenshots are large binaries — regenerate with:
#   deno task responsive --page v<N>/<slug> --screenshots
reports/conformance/shots/
reports/speculation-rules/
.pi-subagents/
# Python bytecode from the .claude helper scripts (gendn-crn). Without these, the tests that
# IMPORT .claude/fix-slugs.py (test-fix-slugs, test-chromestatus-units - both load it via
# importlib) leave untracked .claude/__pycache__/, so "the working tree is clean" - a signal
# reviewers and landing lanes quote as evidence - is permanently false. The trigger is the
# IMPORT, not a direct run: CPython does not write bytecode for a script it runs as __main__.
# Scoped to bytecode and the __pycache__ directory only: never .claude/ itself, whose .py
# sources are tracked and must stay visible to git status.
__pycache__/
*.pyc
