  "outOfScope": [
    {
      "name": "numberOfChannels",
      "rationale": "Pre-existing Web Audio 1.0 OfflineAudioContextOptions member (and constructor argument) quoted as IDL context; PR #2675 and the Chromium flag do not change it. MDN documents it under the OfflineAudioContext() constructor."
    },
    {
      "name": "sampleRate",
      "rationale": "Pre-existing required OfflineAudioContextOptions member / constructor argument quoted as context; unchanged by incremental rendering. MDN documents it under the OfflineAudioContext() constructor."
    },
    {
      "name": "renderSizeHint",
      "rationale": "Belongs to the separate configurable render quantum feature (Chromium flag WebAudioConfigurableRenderQuantum, BCD options_renderSizeHint_parameter); quoted because it sets the render quantum that chunkSize rounds to, which start-rendering/#parameters explains."
    },
    {
      "name": "resume",
      "rationale": "Pre-existing OfflineAudioContext.resume() (Web Audio 1.0, documented on MDN); its IDL is unchanged. Its interaction with chunked rendering is documented in start-rendering/#lifecycle and close/#lifecycle."
    },
    {
      "name": "suspend",
      "rationale": "Pre-existing OfflineAudioContext.suspend() (Web Audio 1.0, documented on MDN); IDL unchanged. Chunk-boundary suspend behavior and the indefinite-length duration check are documented in start-rendering/#lifecycle and indefinite-length/#lifecycle."
    },
    {
      "name": "oncomplete",
      "rationale": "Pre-existing legacy event handler (Web Audio 1.0, documented on MDN); IDL unchanged. Its chunked-mode timing (fires once with the final chunk in Chromium; never for null length or after close) is documented in start-rendering/#complete-event."
    }
  ]
