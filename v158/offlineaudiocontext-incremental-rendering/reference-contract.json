  "outOfScope": [
    {
      "name": "resume",
      "rationale": "OfflineAudioContext.resume() is unchanged (Chrome 41, BCD); its interaction with chunked rendering is covered in the chunked-rendering-model lifecycle section. Documented on MDN."
    },
    {
      "name": "suspend",
      "rationale": "OfflineAudioContext.suspend() is unchanged (Chrome 41, BCD); only the skipped total-duration check for null-length contexts is new, covered on the undefined-length page."
    },
    {
      "name": "oncomplete",
      "rationale": "The complete event handler is pre-existing (Chrome 25, BCD); its once-per-finite-render firing with the final chunk is documented under chunked-rendering-model."
    },
    {
      "name": "numberOfChannels",
      "rationale": "OfflineAudioContextOptions.numberOfChannels is unchanged by this feature (Chrome 62 options parameter, BCD); quoted for dictionary context."
    },
    {
      "name": "sampleRate",
      "rationale": "OfflineAudioContextOptions.sampleRate is unchanged and still required; quoted for dictionary context."
    },
    {
      "name": "renderSizeHint",
      "rationale": "renderSizeHint is a separate feature (WebAudioConfigurableRenderQuantum, Chrome 153 per BCD); it only sets the render quantum that chunk sizes round to, which the chunk-length table explains."
    }
  ]
