{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gendn.paulkinlan-ea.deno.net/schema/goals.schema.json",
  "title": "gendn goals backlog (goals.json)",
  "description": "Additive backlog fed by critique `followUpGoals`. The routine consumes it to pick the next ADDITIVE page (a new `v<N>/<slug>/`) or a targeted in-place fix. Goals NEVER authorize replacing a stable page — only additions and same-id fixes (durable-demo contract).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "goals"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string" },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourcePage", "goal", "kind", "priority", "status"],
        "properties": {
          "id": { "type": "string" },
          "sourcePage": {
            "type": "string",
            "description": "The critique page id `v<N>/<slug>` this goal was derived from."
          },
          "goal": { "type": "string" },
          "kind": { "type": "string", "enum": ["additive-page", "targeted-fix"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "status": { "type": "string", "enum": ["open", "done"] },
          "suggestedSlug": { "type": "string" },
          "createdAt": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
