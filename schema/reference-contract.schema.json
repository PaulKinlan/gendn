{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gendn.paulkinlan-ea.deno.net/schema/reference-contract.schema.json",
  "title": "gendn implementation-sufficiency reference contract",
  "description": "A sourced, exact inventory of a feature's developer-facing surface and the stable documentation that covers every item. Structural validation is fail-closed; semantic correctness still requires independent source review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "route",
    "kind",
    "completeness",
    "assessedAt",
    "assessor",
    "sources",
    "inventory",
    "documentation"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^v[0-9]+/[a-z0-9-]+$" },
    "route": { "type": "string", "pattern": "^/v[0-9]+/[a-z0-9-]+/$" },
    "kind": {
      "type": "string",
      "enum": [
        "web-api",
        "http-protocol",
        "css",
        "html",
        "policy",
        "platform-capability",
        "deprecation",
        "other"
      ]
    },
    "completeness": { "type": "string", "enum": ["implementation-sufficient", "partial"] },
    "assessedAt": { "type": "string", "minLength": 10 },
    "assessor": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "url", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": {
            "type": "string",
            "enum": [
              "normative-spec",
              "explainer",
              "web-idl",
              "browser-data",
              "implementation",
              "test",
              "intent",
              "release-doc",
              "other"
            ]
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": [
              "interface",
              "constructor",
              "method",
              "property",
              "event",
              "dictionary",
              "enum",
              "header",
              "directive",
              "field",
              "state",
              "algorithm",
              "css-property",
              "css-descriptor",
              "css-function",
              "css-value",
              "element",
              "attribute",
              "capability",
              "migration",
              "other"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          }
        }
      }
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventoryId", "href", "dimensions"],
        "properties": {
          "inventoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "href": { "type": "string", "minLength": 1 },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "syntax",
              "inputs",
              "outputs",
              "errors",
              "context",
              "lifecycle",
              "examples",
              "compatibility",
              "securityPrivacy"
            ],
            "properties": {
              "syntax": { "$ref": "#/definitions/dimension" },
              "inputs": { "$ref": "#/definitions/dimension" },
              "outputs": { "$ref": "#/definitions/dimension" },
              "errors": { "$ref": "#/definitions/dimension" },
              "context": { "$ref": "#/definitions/dimension" },
              "lifecycle": { "$ref": "#/definitions/dimension" },
              "examples": { "$ref": "#/definitions/dimension" },
              "compatibility": { "$ref": "#/definitions/dimension" },
              "securityPrivacy": { "$ref": "#/definitions/dimension" }
            }
          }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceRefs"],
      "properties": {
        "status": { "type": "string", "enum": ["documented", "not-applicable", "missing"] },
        "selector": { "type": "string", "pattern": "^#[A-Za-z][A-Za-z0-9_-]*$" },
        "rationale": { "type": "string", "minLength": 20 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    }
  }
}
