{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gendn.paulkinlan-ea.deno.net/schema/questions.schema.json",
  "title": "gendn per-page critique (_questions.json)",
  "description": "Versioned, MUTABLE reviewer pass over one reference page. Evolves (bump `revision`). Rubric dimensions suit a REFERENCE site (factual/source fidelity, milestone mapping, completeness, explanation quality, examples, browser-compat/fallbacks, links validity, accessibility, responsive mobile+desktop UX, relationship to the canonical showcase demo). `guidanceConsulted` MUST be non-empty for any critique that judges frontend/responsive/a11y dimensions — an empty array is an INCOMPLETE critique (the validator fails it). `followUpGoals` feed goals.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "route",
    "identity",
    "milestone",
    "status",
    "revision",
    "reviewedAt",
    "reviewer",
    "rubric",
    "guidanceConsulted",
    "openQuestions",
    "followUpGoals"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^v[0-9]+/[a-z0-9-]+$" },
    "route": { "type": "string", "pattern": "^/v[0-9]+/[a-z0-9-]+/$" },
    "identity": { "type": "string", "pattern": "^[0-9]+$" },
    "milestone": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["built", "stub"] },
    "revision": { "type": "integer", "minimum": 1 },
    "reviewedAt": { "type": "string" },
    "reviewer": { "type": "string" },
    "frontendTouched": {
      "type": "boolean",
      "description": "True when the critique judges frontend/responsive/a11y dimensions. When true, guidanceConsulted must be non-empty."
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "score", "severity", "evidence"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "factual-source-fidelity",
              "milestone-mapping",
              "completeness",
              "explanation-quality",
              "examples",
              "browser-compat-fallbacks",
              "links-validity",
              "accessibility",
              "responsive-ux",
              "showcase-demo-relationship"
            ]
          },
          "score": { "type": "integer", "minimum": 0, "maximum": 5 },
          "severity": { "type": "string", "enum": ["info", "minor", "major", "critical"] },
          "evidence": {
            "type": "string",
            "description": "REAL retained evidence: screenshot path, DOM excerpt, spec/BCD citation, console line, latency.",
            "minLength": 1
          },
          "notes": { "type": "string" }
        }
      }
    },
    "guidanceConsulted": {
      "type": "array",
      "description": "modern-web-guidance lookups performed for this page's frontend topics. Each records what was searched, the recommendation, and how it was applied or why excepted.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "recommendation", "appliedOrException"],
        "properties": {
          "id": { "type": "string" },
          "query": { "type": "string" },
          "recommendation": { "type": "string" },
          "appliedOrException": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "followUpGoals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal", "kind", "priority"],
        "properties": {
          "goal": { "type": "string" },
          "kind": { "type": "string", "enum": ["additive-page", "targeted-fix"] },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "suggestedSlug": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
