{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "typescript": {
    "deno": true,
    "quoteStyle": "preferDouble",
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "json": {
    "deno": true,
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "includes": [
    "**/*.{ts,js,mjs,cjs,json,jsonc}"
  ],
  "excludes": [
    "**/node_modules",
    "dist",
    ".wrangler",
    ".claude",
    "_data",
    "v[0-9]*/**/*.js",
    "v[0-9]*/**/*.json",
    "package-lock.json",
    "deno.lock"
  ],
  "plugins": [
    "./node_modules/@dprint/typescript/plugin.wasm",
    "./node_modules/@dprint/json/plugin.wasm"
  ]
}
