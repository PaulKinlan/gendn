{
  "name": "gendn",
  "private": true,
  "description": "Generated reference docs for Chrome web platform APIs. Hosted on Cloudflare Workers.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch serve.ts",
    "start": "node serve.ts",
    "build": "node scripts/build-worker-assets.mjs",
    "worker:dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "check": "tsc -p . && dprint check && node scripts/check-citation-links.mjs && node scripts/check-surface-coverage.mjs",
    "check:fast": "tsc -p . && node scripts/check-routes.mjs",
    "manifest": "node scripts/route-manifest.mjs",
    "check-routes": "node scripts/check-routes.mjs",
    "refresh-bindings": "node scripts/refresh-bindings.mjs",
    "gen-conformance": "node scripts/gen-conformance.mjs",
    "conformance": "node scripts/conformance.mjs",
    "responsive": "node scripts/conformance.mjs --responsive",
    "css-drift": "node scripts/css-drift.mjs",
    "validate-artifacts": "node scripts/validate-artifacts.mjs",
    "report-surface-coverage": "node scripts/check-surface-coverage.mjs --all",
    "check-verdict-emission": "node scripts/check-verdict-emission.mjs",
    "test-verdict-emission": "node scripts/check-verdict-emission.test.mjs",
    "test-reference-contract": "node scripts/cdp.test.mjs && node scripts/reference-contract.test.mjs && node scripts/reference-browser.test.mjs",
    "test-css-drift-browser": "node scripts/css-drift-browser.test.mjs",
    "gate:fast": "node scripts/gate-map.mjs --tier fast",
    "gate:full": "node scripts/gate-map.mjs --tier full",
    "check-conformance": "node scripts/check-conformance.mjs",
    "build-goals": "node scripts/build-goals.mjs",
    "vendor-fonts": "node scripts/vendor-fonts.mjs",
    "test-fixtures": "node scripts/run-fixtures.mjs",
    "fixture-timeout-probe": "node scripts/fixture-timeout-probe.mjs",
    "fixture-detach-hang": "PROBE_MODE=hang node scripts/fixture-detach-probe.mjs",
    "fixture-detach-exit": "PROBE_MODE=exit node scripts/fixture-detach-probe.mjs",
    "fixture-depth-probe": "node scripts/fixture-depth-probe.mjs",
    "fixture-nested-timeout-probe": "node scripts/fixture-nested-timeout-probe.mjs",
    "verify-speculation-rules": "node scripts/verify-browser-acceptance.mjs",
    "check-citation-links": "node scripts/check-citation-links.mjs"
  },
  "devDependencies": {
    "@dprint/json": "0.26.0",
    "@dprint/typescript": "0.101.0",
    "@types/node": "22.20.5",
    "dprint": "0.65.0",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
