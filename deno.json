{
  "license": "Apache-2.0",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env server.ts",
    "start": "deno run --allow-net --allow-read --allow-env server.ts",
    "check": "deno check server.ts",
    "fmt": "deno fmt",
    "manifest": "deno run --allow-read --allow-run scripts/route-manifest.mjs",
    "check-routes": "deno run --allow-read --allow-run scripts/check-routes.mjs",
    "gen-conformance": "deno run --allow-read --allow-write scripts/gen-conformance.mjs",
    "conformance": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/conformance.mjs",
    "responsive": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/conformance.mjs --responsive",
    "validate-artifacts": "deno run --allow-read scripts/validate-artifacts.mjs",
    "test-cdp": "deno run --allow-read --allow-env scripts/cdp.test.mjs",
    "check-verdict-emission": "deno run --allow-read scripts/check-verdict-emission.mjs",
    "test-verdict-emission": "deno run --allow-read --allow-write --allow-run scripts/check-verdict-emission.test.mjs",
    "test-reference-contract": "deno run --allow-read --allow-env scripts/cdp.test.mjs && deno run --allow-read --allow-write scripts/reference-contract.test.mjs && deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/reference-browser.test.mjs",
    "check-conformance": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/check-conformance.mjs",
    "build-goals": "deno run --allow-read --allow-write scripts/build-goals.mjs",
    "test-fetch-bounded": "deno run --allow-net=127.0.0.1 --allow-read scripts/fetch-bounded.test.mjs",
    "test-external-url": "deno run --allow-read scripts/external-url.test.mjs",
    "vendor-fonts": "deno run --allow-net=fonts.googleapis.com,fonts.gstatic.com --allow-read --allow-write scripts/vendor-fonts.mjs",
    "test-example-adjacency": "deno run --allow-read scripts/example-adjacency.test.mjs"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "exclude": [
      "**/*.html",
      "**/*.css",
      "**/*.md",
      ".claude/",
      "_data/",
      "v[0-9]*/**/*.js",
      "v[0-9]*/**/*.json"
    ]
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  }
}
