{
  "license": "Apache-2.0",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env server.ts",
    "start": "deno run --allow-net --allow-read --allow-env server.ts",
    "check": "deno check server.ts && git ls-files -- ':/*.ts' ':/*.js' ':/*.mjs' ':/*.cjs' ':/*.json' ':/*.jsonc' ':/*.yml' ':/*.yaml' | grep -q . && git ls-files -z -- ':/*.ts' ':/*.js' ':/*.mjs' ':/*.cjs' ':/*.json' ':/*.jsonc' ':/*.yml' ':/*.yaml' | xargs -0 deno fmt --check server.ts && deno run --allow-read --allow-run scripts/check-citation-links.mjs && deno run --allow-read --allow-run scripts/check-surface-coverage.mjs",
    "fmt": "deno fmt",
    "manifest": "deno run --allow-read --allow-run scripts/route-manifest.mjs",
    "check-routes": "deno run --allow-read --allow-run scripts/check-routes.mjs",
    "gen-conformance": "deno run --allow-read --allow-write scripts/gen-conformance.mjs",
    "conformance": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/conformance.mjs",
    "responsive": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/conformance.mjs --responsive",
    "validate-artifacts": "deno run --allow-read scripts/validate-artifacts.mjs",
    "report-surface-coverage": "deno run --allow-read scripts/check-surface-coverage.mjs --all",
    "test-surface-coverage": "deno run --allow-read --allow-write --allow-run scripts/surface-coverage.test.mjs",
    "test-cdp": "deno run --allow-read --allow-env scripts/cdp.test.mjs",
    "check-verdict-emission": "deno run --allow-read scripts/check-verdict-emission.mjs",
    "test-verdict-emission": "deno run --allow-read --allow-write --allow-run scripts/check-verdict-emission.test.mjs",
    "test-reference-contract": "deno run --allow-read --allow-env scripts/cdp.test.mjs && deno run --allow-read --allow-write scripts/reference-contract.test.mjs && deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/reference-browser.test.mjs",
    "test-reference-contract-order": "deno run --allow-read --allow-write scripts/reference-contract-order.test.mjs",
    "check-conformance": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/check-conformance.mjs",
    "build-goals": "deno run --allow-read --allow-write scripts/build-goals.mjs",
    "test-fetch-bounded": "deno run --allow-net=127.0.0.1 --allow-read scripts/fetch-bounded.test.mjs",
    "test-external-url": "deno run --allow-read scripts/external-url.test.mjs",
    "vendor-fonts": "deno run --allow-net=fonts.googleapis.com,fonts.gstatic.com --allow-read --allow-write scripts/vendor-fonts.mjs",
    "test-mdn-has": "deno check lib/mdn.ts && deno run --allow-read --allow-net=127.0.0.1 scripts/mdn-has.test.mjs",
    "test-threat-model-citations": "deno run --allow-read scripts/threat-model-citations.test.mjs",
    "test-vendor-fonts": "deno run --allow-read --allow-write --allow-net --allow-run scripts/vendor-fonts.test.mjs",
    "test-example-adjacency": "deno run --allow-read scripts/example-adjacency.test.mjs",
    "test-chromestatus-units": "deno run --allow-env=CHROMESTATUS_BASE,PORT --allow-net=127.0.0.1 --allow-read --allow-run=python3 --allow-write=v141 scripts/chromestatus-units.test.mjs",
    "test-artifacts-units": "deno run --allow-read --allow-write scripts/artifacts-units.test.mjs",
    "test-suite-metadata": "deno run --allow-read --allow-write --allow-run scripts/suite-metadata.test.mjs",
    "test-support-record": "deno run --allow-read --allow-write --allow-run scripts/support-record.test.mjs",
    "test-fix-slugs": "deno run --allow-read --allow-write --allow-run=python3 scripts/fix-slugs.test.mjs",
    "test-lifecycle-units": "deno run --allow-read --allow-write --allow-run=deno scripts/lifecycle-units.test.mjs",
    "test-iframe-posture": "deno run --allow-read scripts/iframe-posture.test.mjs",
    "test-fixtures": "deno run --allow-all scripts/run-fixtures.mjs",
    "fixture-timeout-probe": "deno run --allow-write --allow-env scripts/fixture-timeout-probe.mjs",
    "fixture-detach-hang": "PROBE_MODE=hang deno run --allow-read --allow-write --allow-run --allow-env scripts/fixture-detach-probe.mjs",
    "fixture-detach-exit": "PROBE_MODE=exit deno run --allow-read --allow-write --allow-run --allow-env scripts/fixture-detach-probe.mjs",
    "fixture-depth-probe": "deno run --allow-env scripts/fixture-depth-probe.mjs",
    "fixture-nested-timeout-probe": "deno run --allow-run --allow-env scripts/fixture-nested-timeout-probe.mjs",
    "test-run-fixtures": "deno run --allow-read --allow-write --allow-run --allow-env scripts/run-fixtures.test.mjs",
    "test-citation-canonical": "deno run --allow-read scripts/citation-canonical.test.mjs",
    "test-server-escape": "deno run --allow-read --allow-write --allow-run --allow-net=127.0.0.1,localhost --allow-env scripts/server-escape.test.mjs",
    "test-source-disagreement": "deno run --allow-read scripts/source-disagreement.test.mjs",
    "test-security-headers": "deno run --allow-read --allow-run --allow-net=127.0.0.1,localhost --allow-env scripts/security-headers.test.mjs",
    "test-transport-headers": "deno run --allow-read --allow-run --allow-net=127.0.0.1,localhost --allow-env scripts/transport-headers.test.mjs",
    "test-vary-merge": "deno run --allow-read --allow-env=PORT scripts/vary-merge.test.mjs",
    "test-route-contract": "deno run --allow-read --allow-run scripts/route-contract.test.mjs",
    "test-speculation-rules": "deno run --allow-read --allow-env --allow-net=127.0.0.1,localhost scripts/speculation-rules.test.mjs",
    "verify-speculation-rules": "deno run --allow-all scripts/verify-browser-acceptance.mjs",
    "test-conformance-report": "deno run --allow-read --allow-write scripts/conformance-report.test.mjs",
    "check-citation-links": "deno run --allow-read --allow-run scripts/check-citation-links.mjs",
    "test-citation-links": "deno run --allow-read --allow-write --allow-run scripts/citation-links.test.mjs"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "exclude": [
      "**/*.html",
      "**/*.css",
      "**/*.md",
      ".claude/",
      "_data/",
      "v[0-9]*/**/*.js",
      "v[0-9]*/**/*.json"
    ]
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  }
}
